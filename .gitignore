## Ignore Visual Studio temporary files, build results, and
## files generated by popular .NET tools

# Build directories
bin/
obj/
**/bin/
**/obj/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/
*.sln.iml

# DotNet Core publish output
publish/
out/

# NuGet
packages/
*.nupkg
project.lock.json
project.fragment.lock.json

# Resharper
_ReSharper*/
*.DotSettings.user

# Visual Studio Code
.vscode/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Rider and other IDE caches
/.idea/
